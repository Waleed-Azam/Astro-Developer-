{
  "name": "fjord-and-form-astro",
  "type": "module",
  "version": "1.0.0",
  "description": "Demo: Webflow → Astro migration. Fictional studio site rebuilt pixel-faithfully in Astro + Cloudflare + Resend + Railway.",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro check && astro build",
    "build:no-check": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check": "astro check",
    "audit:webflow": "node scripts/export-webflow-audit.mjs"
  },
  "dependencies": {
    "astro": "^4.16.4",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^10.2.2",
    "@types/node": "^26.6.3",
    "typescript": "^5.6.3"
  }
}
