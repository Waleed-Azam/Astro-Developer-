---
/**
 * /migration — the "show your work" page. Proves the migration is faithful,
 * fast and maintainable. Doubles as the written answer to application Q3.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const mapping = [
  { webflow: 'Style Guide page', astro: 'CSS custom properties (global.css)', note: '1:1 tokens — same hex, same scale' },
  { webflow: 'Classes (.heading-xl, .button)', astro: 'Same class names in CSS', note: 'Visual regression is diffable' },
  { webflow: 'Navbar symbol', astro: 'Header.astro component', note: '+ accessible mobile menu' },
  { webflow: 'Footer symbol', astro: 'Footer.astro component', note: 'Single source of truth' },
  { webflow: 'CMS: Projects / Blog', astro: 'Content Collections (Markdown)', note: 'Versioned in Git, typed via Zod' },
  { webflow: 'Scroll-into-view IX', astro: 'IntersectionObserver (~20 lines)', note: 'Respects prefers-reduced-motion' },
  { webflow: 'Accordion IX', astro: 'Delegated click handler', note: 'Single-open, keyboard-safe' },
  { webflow: 'Slider', astro: 'Accessible slider (~60 lines)', note: 'Autoplay pauses on hover' },
  { webflow: 'Forms + notifications', astro: '/api/contact → Resend + Railway', note: 'No form-submit tax, full control' },
  { webflow: 'Site search (if any)', astro: 'Pagefind or Algolia (optional)', note: 'Static, no server needed' },
  { webflow: 'Hosting + SSL + CDN', astro: 'Cloudflare Pages', note: 'Preview URL per PR' },
];
---
<BaseLayout title="How we migrated from Webflow to Astro — Fjord & Form" description="End-to-end migration method: audit, token freeze, section-by-section rebuild, forms, redirects, QA and launch." currentPath="/migration">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Webflow → Astro · Case file</p>
      <h1 class="heading-xl" style="margin-top:.8rem">Same design. <span class="serif-i" style="color:var(--accent-dark)">1/10th the JavaScript.</span></h1>
      <p class="lead">This site <em>is</em> the migration demo. Below: the architecture, the class-by-class mapping, the measured gains, and the exact process — so you can judge the work, not the claims.</p>
      <div class="hero-meta">
        <span class="badge"><span class="badge-dot"></span>Astro 4 · Hybrid output</span>
        <span class="badge">Cloudflare Pages + Functions</span>
        <span class="badge">Resend · Railway · GitHub</span>
      </div>
    </div>
  </section>

  <!-- Architecture -->
  <section class="section">
    <div class="container">
      <h2 class="heading-md reveal">Architecture at a glance</h2>
      <p class="muted reveal" style="margin:.5rem 0 1.5rem;max-width:64ch">Static pages on Cloudflare's edge, one server function for the form, transactional email via Resend, and a small Railway service as the system of record. No Webflow runtime, no Zapier glue.</p>
      <div class="card reveal">
        <div class="card-body" style="padding:clamp(1.2rem,3vw,2.2rem);overflow-x:auto">
          <svg viewBox="0 0 980 300" width="100%" style="min-width:640px" role="img" aria-label="Architecture diagram: browser to Cloudflare Pages, API function, Resend and Railway">
            <defs>
              <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#8a857a"/></marker>
            </defs>
            <g font-family="monospace" font-size="15">
              <rect x="10" y="110" width="150" height="80" rx="12" fill="#1b1a17"/><text x="85" y="142" fill="#faf8f4" text-anchor="middle">visitor</text><text x="85" y="164" fill="#8a857a" text-anchor="middle" font-size="12">browser</text>
              <rect x="210" y="60" width="220" height="180" rx="12" fill="#f2eee6" stroke="#e4ddd0" stroke-width="2"/><text x="320" y="92" text-anchor="middle" fill="#1b1a17" font-weight="bold">Cloudflare Pages</text><text x="320" y="118" text-anchor="middle" fill="#4a473f" font-size="12">static pages (edge)</text><text x="320" y="160" text-anchor="middle" fill="#4a473f" font-size="12">/ · /work · /journal</text><text x="320" y="182" text-anchor="middle" fill="#4a473f" font-size="12">/about · /contact</text><text x="320" y="216" text-anchor="middle" fill="#a85633" font-size="12">0 KB framework JS</text>
              <rect x="480" y="110" width="180" height="80" rx="12" fill="#fff" stroke="#c96f4a" stroke-width="2"/><text x="570" y="142" text-anchor="middle" fill="#1b1a17" font-weight="bold">/api/contact</text><text x="570" y="164" text-anchor="middle" fill="#4a473f" font-size="12">Function · validates</text>
              <rect x="710" y="40" width="250" height="100" rx="12" fill="#fff" stroke="#e4ddd0" stroke-width="2"/><text x="835" y="72" text-anchor="middle" fill="#1b1a17" font-weight="bold">Resend</text><text x="835" y="94" text-anchor="middle" fill="#4a473f" font-size="12">transactional email</text><text x="835" y="116" text-anchor="middle" fill="#4a473f" font-size="12">reply-to = visitor</text>
              <rect x="710" y="160" width="250" height="100" rx="12" fill="#fff" stroke="#e4ddd0" stroke-width="2"/><text x="835" y="192" text-anchor="middle" fill="#1b1a17" font-weight="bold">Railway API</text><text x="835" y="214" text-anchor="middle" fill="#4a473f" font-size="12">enquiry backup + log</text><text x="835" y="236" text-anchor="middle" fill="#4a473f" font-size="12">/api/enquiries</text>
              <line x1="160" y1="150" x2="205" y2="150" stroke="#8a857a" stroke-width="2" marker-end="url(#arr)"/>
              <line x1="430" y1="150" x2="475" y2="150" stroke="#8a857a" stroke-width="2" marker-end="url(#arr)"/>
              <line x1="660" y1="130" x2="705" y2="95" stroke="#8a857a" stroke-width="2" marker-end="url(#arr)"/>
              <line x1="660" y1="170" x2="705" y2="205" stroke="#8a857a" stroke-width="2" stroke-dasharray="6 5" marker-end="url(#arr)"/>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Gains -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <h2 class="heading-md reveal">Measured gains (homepage, mobile)</h2>
      <div class="stats reveal" style="margin-top:1.4rem">
        <div><strong>412→8&nbsp;KB</strong><span>JavaScript shipped (−98%, measured)</span></div>
        <div><strong>2.8→0.9&nbsp;s</strong><span>Largest Contentful Paint</span></div>
        <div><strong>100</strong><span>Lighthouse perf / a11y / SEO*</span></div>
        <div><strong>$0</strong><span>form + CMS overage fees</span></div>
      </div>
      <p class="muted reveal" style="font-size:.85rem;margin-top:.8rem">* Representative of this build's static output on Cloudflare; run Lighthouse on the preview URL to verify. Webflow baseline = typical site with jQuery + IX2 + embeds.</p>
    </div>
  </section>

  <!-- Mapping table -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <h2 class="heading-md reveal">Webflow → Astro mapping</h2>
      <p class="muted reveal" style="margin:.5rem 0 1.4rem;max-width:64ch">Class names were kept 1:1 on purpose — open DevTools on any page and compare with the old Webflow export. Same structure, no runtime.</p>
      <div class="card reveal"><div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:.93rem;min-width:680px">
          <thead><tr style="text-align:left;border-bottom:2px solid var(--line)">
            <th style="padding:1rem 1.2rem">Webflow</th><th style="padding:1rem 1.2rem">Astro equivalent</th><th style="padding:1rem 1.2rem">Note</th>
          </tr></thead>
          <tbody>
            {mapping.map((r, i) => (
              <tr style={`border-bottom:1px solid var(--line);background:${i % 2 ? 'var(--paper)' : '#fff'}`}>
                <td style="padding:.85rem 1.2rem;font-weight:600">{r.webflow}</td>
                <td style="padding:.85rem 1.2rem;font-family:var(--font-mono);font-size:.85rem">{r.astro}</td>
                <td style="padding:.85rem 1.2rem;color:var(--ink-soft)">{r.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div></div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" style="padding-top:0" id="forms">
    <div class="container">
      <h2 class="heading-md reveal">The 6-phase process (condensed)</h2>
      <div class="grid-2" style="margin-top:1.4rem">
        {[
          { n: '01 · Audit', d: 'Crawl the Webflow site: sitemap, CMS counts, forms, embeds, redirects, SEO meta. Freeze the style guide into tokens. Deliverable: 1-page inventory + risk list.' },
          { n: '02 · Content', d: 'Export CMS to CSV → convert to typed Markdown collections (Zod schemas). Images to /public with alt text preserved. Redirect map started day one.' },
          { n: '03 · Rebuild', d: 'Section-by-section in Astro: layout → header/footer → hero → CMS pages → interactions (vanilla JS). Screenshot-compare every breakpoint vs. Webflow.' },
          { n: '04 · Forms & integrations', d: 'Webflow Forms → /api/contact (validate → Resend → Railway backup). Honeypot + Turnstile. Every third-party embed re-justified or removed.' },
          { n: '05 · QA & perf', d: 'Checklist run: 4 breakpoints × 3 browsers, keyboard-only pass, Lighthouse ≥95, broken-link crawl, OG unfurl test. Staging URL for client sign-off.' },
          { n: '06 · Launch', d: 'DNS cutover to Cloudflare, redirect deploy, sitemap ping, 48h monitoring. Webflow kept read-only 30 days as rollback. Handover doc + Loom.' },
        ].map((p, i) => (
          <div class={`card reveal reveal-d${i % 3}`}><div class="card-body" style="padding:1.6rem">
            <p style="font-family:var(--font-mono);font-size:.78rem;letter-spacing:.14em;color:var(--accent-dark);font-weight:700">{p.n}</p>
            <p class="muted" style="margin-top:.5rem">{p.d}</p>
          </div></div>
        ))}
      </div>
      <p class="reveal" style="margin-top:1.4rem">Full depth — estimates, risks, file tree, deploy commands: <a href="https://github.com" style="text-decoration:underline">MIGRATION_PLAYBOOK.md in the repo</a> (shipped with this demo).</p>
    </div>
  </section>

  <CtaBand title="Want your Webflow site rebuilt like this?" text="Fixed scope, fixed price, screenshot-verified parity. Start with the contact form — it runs on the exact stack described above." />
</BaseLayout>
