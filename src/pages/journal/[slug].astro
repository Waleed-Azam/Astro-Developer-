---
/** Journal article — Webflow "Blog Posts Template" → Astro dynamic route. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('journal');
  return posts.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}
const { slug } = Astro.props;
const all = (await getCollection('journal')).filter((p) => !p.data.draft);
const entry = all.find((p) => p.slug === slug);
if (!entry) return Astro.redirect('/404');
const { Content } = await entry.render();
const { data } = entry;
const more = all.filter((p) => p.slug !== slug).slice(0, 2);
---
<BaseLayout title={`${data.title} — Fjord & Form`} description={data.description} currentPath="/journal" ogImage={data.cover}>
  <section class="page-hero">
    <div class="container" style="max-width:820px;margin-inline:auto">
      <p><a href="/journal" style="text-decoration:underline">← All articles</a></p>
      <div class="tag-row" style="margin-top:1rem">{data.tags.map((t) => (<span class="tag">{t}</span>))}</div>
      <h1 class="heading-lg" style="margin-top:.8rem">{data.title}</h1>
      <p class="muted" style="margin-top:.8rem">{data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })} · {data.author} · {Math.max(2, Math.round(data.description.length / 220))} min read</p>
    </div>
  </section>
  <section class="section-tight">
    <div class="container" style="max-width:820px;margin-inline:auto">
      <img src={data.cover} alt={data.coverAlt} style="border-radius:var(--radius-lg);border:1px solid var(--line);width:100%" width="1200" height="900" />
      <div class="prose" style="margin-top:2rem"><Content /></div>
    </div>
  </section>
  {more.length > 0 && (
    <section class="section-tight">
      <div class="container">
        <h2 class="heading-md" style="margin-bottom:1.4rem">Read next</h2>
        <div class="grid-2">
          {more.map((p) => (
            <a href={`/journal/${p.slug}`} class="card">
              <div class="card-body"><h3 class="heading-sm">{p.data.title}</h3><p class="muted">{p.data.description}</p></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <CtaBand />
</BaseLayout>
