          <li>Verksgata 12<br />4013 Stavanger</li>
          <li><a href="mailto:hello@fjord-and-form.demo">hello@fjord-and-form.demo</a></li>
          <li><a href="tel:+4751900000">+47 519 00 000</a></li>
        </ul>
