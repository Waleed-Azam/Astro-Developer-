---
/** Header — migrated from Webflow "Navbar" symbol. Active link via currentPath. */
interface Props { currentPath?: string }
const { currentPath = '/' } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'Studio' },
  { href: '/journal', label: 'Journal' },
  { href: '/migration', label: 'Migration' },
];
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---
<header class="site-header">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Fjord & Form — home">
      <span class="brand-mark" aria-hidden="true">F</span>
      <span>Fjord &amp; Form<small>Stavanger · Est. 2016</small></span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-links">
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="nav-cta">
      <a href="/contact" class="button button-primary button-sm">Start a project <span class="arrow" aria-hidden="true">→</span></a>
      <button class="menu-button" data-menu-button aria-expanded="false" aria-controls="mobile-menu">Menu ☰</button>
    </div>
  </div>
  <div class="mobile-menu" data-mobile-menu id="mobile-menu">
    <div class="container">
      {links.map((l) => (<a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>))}
      <a href="/contact">Start a project →</a>
    </div>
  </div>
</header>
