---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Fjord & Form" currentPath="/">
  <section class="section"><div class="container" style="text-align:center;max-width:560px">
    <p class="eyebrow" style="justify-content:center">404</p>
    <h1 class="heading-xl" style="margin-top:.8rem">This room <span class="serif-i" style="color:var(--accent-dark)">doesn't exist.</span></h1>
    <p class="lead" style="margin-top:1rem">The page moved or was never built. Let's get you back to solid ground.</p>
    <div style="margin-top:1.6rem;display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap">
      <a href="/" class="button button-primary">Back home</a>
      <a href="/work" class="button button-ghost">See our work</a>
    </div>
  </div></section>
</BaseLayout>
